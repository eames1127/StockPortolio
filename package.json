{
  "name": "stock-portfolio-tracker",
  "version": "1.0.0",
  "description": "Stock portfolio tracker inspired by sovereign wealth fund principles",
  "main": "server/index.js",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "yahoo-finance2": "^4.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "test": "jest tests/",
    "test:server": "jest tests/",
    "test:client": "cd client && npm test",
    "lint": "eslint . && prettier --check \"**/*.{js,vue,css}\"",
    "format": "prettier --write \"**/*.{js,vue,css}\""
  }
}
